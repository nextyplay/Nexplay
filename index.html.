<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#080817"><meta name="description" content="NEXPLAY: sua arena de jogos, desafios e conquistas.">
<title>NEXPLAY | Arena gamer</title>
<style>
:root{--bg:#080817;--panel:#14142b;--panel2:#1d1d3b;--gold:#8b7cff;--gold2:#42d9ff;--muted:#aaa9c8;--line:#34345d}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 75% -10%,#25205e 0,transparent 38%),radial-gradient(circle at 5% 40%,#102b48 0,transparent 30%),var(--bg);color:#f7f3e9;font:16px/1.5 system-ui,Arial,sans-serif}
header{position:sticky;top:0;z-index:5;background:#080817ed;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}
.nav{max-width:1120px;margin:auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.logo{font-weight:1000;letter-spacing:2px;color:#9d91ff;font-size:1.45rem;text-shadow:0 0 18px #7668ff88}.logo span{color:#fff}
nav{display:flex;gap:16px;flex-wrap:wrap}a{color:var(--gold);text-decoration:none}nav a{color:#eee;font-size:.92rem}nav a:hover{color:var(--gold)}
main{max-width:1120px;margin:auto;padding:30px 20px 70px}.hero{padding:55px 0 42px;display:grid;grid-template-columns:1.3fr .7fr;gap:28px;align-items:center}
.eyebrow{color:var(--gold);font-weight:800;letter-spacing:2px;text-transform:uppercase;font-size:.78rem}h1{font-size:clamp(2.5rem,7vw,5rem);line-height:.98;margin:12px 0}h1 em{color:var(--gold);font-style:normal}.lead{color:#c8c2b4;max-width:650px;font-size:1.1rem}
.hero-card,.card{background:linear-gradient(145deg,#1b1b3b,#101024);border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 15px 40px #0007}
.hero-card{border-color:#655de0}.statrow{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.stat{background:#191936;border:1px solid #514b8c;border-radius:12px;padding:12px 16px;min-width:105px}.stat b{display:block;color:var(--gold);font-size:1.4rem}
.btn{border:0;border-radius:10px;padding:12px 17px;background:linear-gradient(100deg,#8b7cff,#42d9ff);color:#09091b;box-shadow:0 5px 22px #7165ff33;font-weight:900;cursor:pointer}.btn:hover{filter:brightness(1.1)}.btn.secondary{background:#27231a;color:var(--gold);border:1px solid #65501e}.btn:disabled{opacity:.5;cursor:not-allowed}
section{margin:34px 0;scroll-margin-top:90px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:15px}h2{font-size:1.8rem;margin:0}h3{margin:0 0 8px;color:var(--gold)}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.game-icon{font-size:2rem}.game-card{min-height:210px;display:flex;flex-direction:column;gap:10px}.game-card p{color:#bdb7aa;margin:0;flex:1}
label{display:block;color:#cfc8b9;font-size:.9rem;margin:8px 0 5px}input,textarea{width:100%;padding:12px;border-radius:10px;border:1px solid #4a4438;background:#0e0e0e;color:white;font:inherit}textarea{min-height:90px;resize:vertical}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.row>*{flex:1}.gamebox{background:#0d0d22;border:1px dashed #625be0;border-radius:14px;padding:20px;text-align:center;min-height:155px;display:grid;place-items:center}
#reactionPad{width:100%;min-height:110px;font-size:1.15rem}.achievement{display:flex;gap:12px;align-items:center;padding:12px;border-bottom:1px solid #333}.achievement:last-child{border:0}.locked{filter:grayscale(1);opacity:.45}.ach-icon{font-size:1.7rem}
.chatlog{height:250px;overflow:auto;background:#0b0b0b;border:1px solid #38332a;border-radius:12px;padding:12px;margin:12px 0}.msg{padding:9px 11px;border-radius:10px;margin:7px 0;max-width:90%;white-space:pre-wrap}.user{background:#30250e;margin-left:auto}.bot{background:#202020}
.note{border-left:3px solid var(--gold);padding:12px 15px;background:#17140e;color:#d5cdbd;border-radius:0 10px 10px 0}.pill{display:inline-block;padding:4px 9px;border:1px solid #625be0;color:#b8b0ff;border-radius:99px;font-size:.8rem}
footer{border-top:1px solid var(--line);padding:24px;text-align:center;color:#928b7d}
@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:35px}.grid{grid-template-columns:1fr}.nav{align-items:flex-start}nav{gap:10px}}

.logo span{color:#42d9ff}.eyebrow{color:#a69cff}.game-card{transition:transform .2s,border-color .2s}.game-card:hover{transform:translateY(-4px);border-color:#7770ef}.shooter-box{display:block;padding:10px;min-height:0}.shooter-box canvas{display:block;width:100%;height:auto;max-height:300px;border-radius:10px;background:#070719;border:1px solid #38356f;touch-action:manipulation}.shooter-hud{display:flex;justify-content:space-between;color:#bdb8ff;font-weight:800;padding:8px 2px}.shooter-controls{gap:8px}.shooter-controls .btn{padding:10px 8px}.shooter-box p{font-size:.78rem;margin:8px 0 0}
</style>
</head>
<body>
<header><div class="nav"><div class="logo">NEX<span>PLAY</span></div><nav><a href="#jogos">Jogos</a><a href="#perfil">Perfil</a><a href="#conquistas">Conquistas</a><a href="#assistente">NEX AI</a></nav></div></header>
<main>
<div class="hero">
 <div><div class="eyebrow">Sua arena começa aqui</div><h1>JOGUE.<br><em>EVOLUA.</em><br>CRIE.</h1><p class="lead">Sua arena gamer: jogue desafios, conquiste recordes e explore novas aventuras direto no navegador.</p><a class="btn" href="#jogos">Entrar na arena</a><div class="statrow"><div class="stat"><b id="heroPoints">0</b><span>pontos</span></div><div class="stat"><b id="heroWins">0</b><span>jogos concluídos</span></div><div class="stat"><b id="heroBadges">0</b><span>conquistas</span></div></div></div>
 <div class="hero-card"><span class="pill">NEXPLAY • NOVA ERA</span><h2>Bem-vindo ao NEXPLAY</h2><p class="muted">Seu progresso fica salvo neste navegador. Escolha um nome de jogador e comece a desbloquear medalhas.</p><div class="game-icon">🎮 🏆 ⚡</div></div>
</div>
<section id="perfil"><div class="section-head"><div><div class="eyebrow">Identidade gamer</div><h2>Seu perfil</h2></div><span class="pill">Salvo neste dispositivo</span></div>
<div class="card"><div class="row"><div><label for="nickname">Nome de jogador</label><input id="nickname" maxlength="20" placeholder="Digite seu nick"></div><div><label>Seu nível</label><div class="stat"><b id="level">1</b><span id="levelName">Novato</span></div></div><div><label>Pontuação total</label><div class="stat"><b id="points">0</b><span>XP</span></div></div></div><p class="muted" id="profileStatus">Escolha seu nick para personalizar o perfil.</p><button class="btn" id="saveNick">Salvar perfil</button></div>
</section>
<section id="jogos"><div class="section-head"><div><div class="eyebrow">Escolha seu desafio</div><h2>Área de jogos</h2></div><span class="pill">Arcade • navegador • mobile</span></div>
<div class="grid">
 <article class="card game-card"><div class="game-icon">⚡</div><h3>Teste de reflexo</h3><p>Espere o sinal ficar verde e toque o botão o mais rápido possível. Faça uma tentativa abaixo de 500 ms.</p><button class="btn" id="startReaction">Começar desafio</button><div class="gamebox"><div><p id="reactionText">Pronto para testar seus reflexos?</p><button class="btn secondary" id="reactionPad" disabled>Aguardando</button></div></div><p class="muted" id="reactionResult">Melhor tempo: —</p></article>
 <article class="card game-card"><div class="game-icon">🧠</div><h3>Memória de cores</h3><p>Repita a sequência de cores. A cada rodada, uma nova cor é adicionada.</p><button class="btn" id="startMemory">Jogar memória</button><div class="gamebox"><div><div class="row"><button class="btn secondary color" data-c="0">🟥</button><button class="btn secondary color" data-c="1">🟦</button><button class="btn secondary color" data-c="2">🟨</button><button class="btn secondary color" data-c="3">🟩</button></div><p id="memoryText">Comece uma rodada.</p></div></div><p class="muted" id="memoryScore">Maior sequência: 0</p></article>
 <article class="card game-card"><div class="game-icon">🎯</div><h3>Desafio de cliques</h3><p>Faça o máximo de pontos em 10 segundos. Clique no alvo sempre que ele aparecer.</p><button class="btn" id="startClick">Iniciar 10 segundos</button><div class="gamebox"><div><div style="font-size:2rem" id="clickScore">0</div><button class="btn secondary" id="target" disabled>🎯 TOCAR!</button><p id="clickTime">Tempo: 10s</p></div></div><p class="muted" id="clickBest">Recorde: 0</p></article>
 <article class="card game-card"><div class="game-icon">🚀</div><h3>Galactic Defender</h3><p>Pilote uma nave espacial, desvie dos meteoros e acerte-os com pulsos de energia. Faça o maior recorde!</p><button class="btn" id="startShooter">Iniciar missão</button><div class="gamebox shooter-box"><canvas id="spaceGame" width="640" height="300" aria-label="Jogo espacial arcade"></canvas><div class="shooter-hud"><span id="spaceScore">Pontos: 0</span><span id="spaceLives">Escudos: 3</span></div><div class="row shooter-controls"><button class="btn secondary" id="moveLeft" aria-label="Mover nave para esquerda">◀</button><button class="btn secondary" id="fireSpace">✦ Disparar</button><button class="btn secondary" id="moveRight" aria-label="Mover nave para direita">▶</button></div><p class="muted" id="spaceHelp">Use ◀ ▶ e Disparar. No computador, use as setas e espaço.</p></div><p class="muted" id="spaceBest">Recorde: 0</p></article>
</div></section>
<section id="conquistas"><div class="section-head"><div><div class="eyebrow">Marcos da jornada</div><h2>Conquistas</h2></div><span class="pill" id="badgeCount">0 desbloqueadas</span></div><div class="card" id="badgeList"></div></section>
<section id="assistente"><div class="section-head"><div><div class="eyebrow">Ajuda para gamers</div><h2>NEX AI</h2></div><span class="pill" id="aiStatus">Verificando conexão…</span></div>
<div class="card"><p class="muted">Pergunte sobre estratégias, ideias de jogos, programação ou como começar um projeto. Quando o servidor e a chave estiverem configurados, as respostas virão da IA. Sem essa configuração, o assistente informa como ativá-la.</p><div class="chatlog" id="chatlog"><div class="msg bot">Olá! Sou o NEX AI. Como posso ajudar na sua jornada gamer?</div></div><label for="question">Sua pergunta</label><textarea id="question" maxlength="2000" placeholder="Ex.: Como começo a criar um jogo 2D?"></textarea><div class="row"><button class="btn" id="send">Enviar pergunta</button><span class="muted" id="chatStatus">Não envie senhas ou informações pessoais.</span></div></div>
</section>
<section><div class="note"><b>Observação importante:</b> esta versão funciona no navegador após ser publicada no GitHub Pages. O perfil e as conquistas são locais, neste navegador, e não uma conta online. A IA real só responde depois que o servidor for publicado e um responsável configurar a chave secreta no ambiente do servidor. Nunca coloque a chave no HTML, no navegador ou em um repositório público.</div></section>
</main><footer>NEXPLAY © 2026 • Jogue com respeito. Aprenda, crie e evolua.</footer>
<script>
const KEY='gamehard_v4_profile';
const defaults={nick:'Player',xp:0,wins:0,badges:[],bestReaction:null,bestMemory:0,bestClick:0,bestShooter:0};
let p={...defaults,...JSON.parse(localStorage.getItem(KEY)||'{}')};
const $=id=>document.getElementById(id);
function save(){localStorage.setItem(KEY,JSON.stringify(p));render()}
function unlock(id){if(!p.badges.includes(id)){p.badges.push(id);return true}return false}
const achievements=[
 ['first','🏁','Primeira partida','Conclua seu primeiro desafio.'],
 ['fast','⚡','Reflexo de ouro','Faça menos de 500 ms no teste de reflexo.'],
 ['memory','🧠','Memória afiada','Chegue à sequência 5 no jogo da memória.'],
 ['clicks','🎯','Mão veloz','Faça 15 pontos no desafio de cliques.'],
 ['xp100','💛','Em evolução','Acumule 100 XP.'],
 ['space','🚀','Defensor galáctico','Conclua uma missão espacial.']
];
function render(){
 $('nickname').value=p.nick==='Player'?'':p.nick;$('points').textContent=p.xp;$('heroPoints').textContent=p.xp;$('heroWins').textContent=p.wins;$('heroBadges').textContent=p.badges.length;$('badgeCount').textContent=p.badges.length+' desbloqueadas';
 let lvl=1+Math.floor(p.xp/100);$('level').textContent=lvl;$('levelName').textContent=['Novato','Explorador','Competidor','Veterano','Lenda'][Math.min(4,lvl-1)];
 $('profileStatus').textContent='Perfil de '+p.nick+' • '+p.wins+' desafios concluídos';
 $('reactionResult').textContent='Melhor tempo: '+(p.bestReaction===null?'—':p.bestReaction+' ms');
 $('memoryScore').textContent='Maior sequência: '+p.bestMemory;$('clickBest').textContent='Recorde: '+p.bestClick;$('spaceBest').textContent='Recorde: '+(p.bestShooter||0);
 $('badgeList').innerHTML=achievements.map(a=>`<div class="achievement ${p.badges.includes(a[0])?'':'locked'}"><span class="ach-icon">${a[1]}</span><div><b>${a[2]}</b><div class="muted">${a[3]}</div></div><span class="pill">${p.badges.includes(a[0])?'Desbloqueada':'Bloqueada'}</span></div>`).join('');
}
function finishGame(xp){p.wins++;p.xp+=xp;unlock('first');if(p.xp>=100)unlock('xp100');save()}
$('saveNick').onclick=()=>{const n=$('nickname').value.trim().slice(0,20);if(n)p.nick=n;save()};
render();
// Reaction game
let reactionTimer=null,started=0,ready=false,waiting=false;
$('startReaction').onclick=()=>{clearTimeout(reactionTimer);ready=false;waiting=true;$('reactionPad').disabled=true;$('reactionPad').textContent='Espere…';$('reactionText').textContent='Não toque ainda!';$('reactionPad').style.background='#9a2424';reactionTimer=setTimeout(()=>{ready=true;started=performance.now();$('reactionPad').disabled=false;$('reactionPad').textContent='AGORA!';$('reactionPad').style.background='#187b3a';$('reactionText').textContent='TOQUE!'},1200+Math.random()*2200)};
$('reactionPad').onclick=()=>{if(!waiting)return;if(!ready){clearTimeout(reactionTimer);waiting=false;$('reactionText').textContent='Muito cedo! Tente novamente.';$('reactionPad').textContent='Falsa partida';return}let ms=Math.round(performance.now()-started);waiting=false;ready=false;$('reactionText').textContent='Seu tempo: '+ms+' ms';$('reactionPad').disabled=true;$('reactionPad').textContent='Concluído';if(p.bestReaction===null||ms<p.bestReaction)p.bestReaction=ms;finishGame(ms<500?35:15);if(ms<500)unlock('fast');save()};
// Memory game
let seq=[],inputSeq=[],memoryActive=false;
const colors=[0,1,2,3];
function showSeq(){let i=0;$('memoryText').textContent='Observe a sequência…';const t=setInterval(()=>{if(i>=seq.length){clearInterval(t);memoryActive=true;inputSeq=[];$('memoryText').textContent='Sua vez! Repita a sequência.';return}const b=document.querySelector(`[data-c="${seq[i]}"]`);b.style.filter='brightness(1.8)';setTimeout(()=>b.style.filter='',250);i++},600)}
$('startMemory').onclick=()=>{seq=[];memoryActive=false;nextMemory()};
function nextMemory(){seq.push(Math.floor(Math.random()*4));showSeq()}
document.querySelectorAll('.color').forEach(b=>b.onclick=()=>{if(!memoryActive)return;let c=Number(b.dataset.c);inputSeq.push(c);if(c!==seq[inputSeq.length-1]){memoryActive=false;$('memoryText').textContent='Fim! Você chegou à sequência '+(seq.length-1)+'.';if(seq.length>1){finishGame(Math.max(5,(seq.length-1)*5))}return}if(inputSeq.length===seq.length){memoryActive=false;p.bestMemory=Math.max(p.bestMemory,seq.length);if(seq.length>=5)unlock('memory');$('memoryText').textContent='Boa! Próxima rodada…';if(seq.length>=5)finishGame(25);save();setTimeout(nextMemory,700)}});
// Click challenge
let clickActive=false,clickRemaining=10,clickCount=0,clickInterval=null;
$('startClick').onclick=()=>{clearInterval(clickInterval);clickActive=true;clickCount=0;clickRemaining=10;$('clickScore').textContent='0';$('clickTime').textContent='Tempo: 10s';$('target').disabled=false;clickInterval=setInterval(()=>{clickRemaining--;$('clickTime').textContent='Tempo: '+clickRemaining+'s';if(clickRemaining<=0){clearInterval(clickInterval);clickActive=false;$('target').disabled=true;$('clickTime').textContent='Fim! Você fez '+clickCount+' pontos.';p.bestClick=Math.max(p.bestClick,clickCount);if(clickCount>=15)unlock('clicks');finishGame(clickCount>=15?35:Math.max(5,clickCount));save()}},1000)};
$('target').onclick=()=>{if(!clickActive)return;clickCount++;$('clickScore').textContent=clickCount};
// Galactic Defender: arcade espacial fictício, com pulsos de energia
const canvas=$('spaceGame'),ctx=canvas.getContext('2d');
let ship={x:320,y:263},bolts=[],meteors=[],spaceRunning=false,spaceScore=0,spaceLives=3,lastMeteor=0,lastShot=0,keys={};
let stars=Array.from({length:55},()=>({x:Math.random()*640,y:Math.random()*300,s:.5+Math.random()*1.8}));
function drawSpace(){ctx.clearRect(0,0,640,300);ctx.fillStyle='#08081d';ctx.fillRect(0,0,640,300);
 stars.forEach(a=>{ctx.fillStyle='#aaa8ff';ctx.globalAlpha=.35+a.s/3;ctx.fillRect(a.x,a.y,a.s,a.s);a.y+=a.s*.45;if(a.y>300){a.y=0;a.x=Math.random()*640}});ctx.globalAlpha=1;
 // nave estilizada
 ctx.save();ctx.translate(ship.x,ship.y);ctx.fillStyle='#48dcff';ctx.shadowColor='#48dcff';ctx.shadowBlur=14;ctx.beginPath();ctx.moveTo(0,-17);ctx.lineTo(14,13);ctx.lineTo(0,7);ctx.lineTo(-14,13);ctx.closePath();ctx.fill();ctx.restore();
 ctx.shadowBlur=9;ctx.shadowColor='#8c7cff';ctx.fillStyle='#b8b0ff';bolts.forEach(b=>{ctx.fillRect(b.x-2,b.y-7,4,12)});ctx.shadowBlur=0;
 meteors.forEach(m=>{ctx.fillStyle='#ff9b70';ctx.strokeStyle='#ffcf9e';ctx.beginPath();ctx.arc(m.x,m.y,m.r,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.fillStyle='#5c355b';ctx.beginPath();ctx.arc(m.x-3,m.y-2,2,0,Math.PI*2);ctx.fill()});
}
function resetShooter(){ship.x=320;bolts=[];meteors=[];spaceScore=0;spaceLives=3;lastMeteor=0;lastShot=0;$('spaceScore').textContent='Pontos: 0';$('spaceLives').textContent='Escudos: 3'}
function endShooter(){spaceRunning=false;$('spaceHelp').textContent='Missão encerrada! Pontuação: '+spaceScore+'. Toque em Iniciar missão para jogar novamente.';p.bestShooter=Math.max(p.bestShooter||0,spaceScore);unlock('space');finishGame(Math.max(10,Math.floor(spaceScore/2)));save();drawSpace()}
function frame(t){if(!spaceRunning){drawSpace();return}
 if(keys.ArrowLeft||keys.left)ship.x=Math.max(18,ship.x-4);if(keys.ArrowRight||keys.right)ship.x=Math.min(622,ship.x+4);
 if((keys.Space||keys.fire)&&t-lastShot>260){bolts.push({x:ship.x,y:ship.y-15});lastShot=t}
 if(t-lastMeteor>760){meteors.push({x:20+Math.random()*600,y:-15,r:9+Math.random()*8,v:1.7+Math.random()*1.2});lastMeteor=t}
 bolts.forEach(b=>b.y-=6);meteors.forEach(m=>m.y+=m.v);bolts=bolts.filter(b=>b.y>-10);
 for(let i=meteors.length-1;i>=0;i--){let m=meteors[i];let hit=false;for(let j=bolts.length-1;j>=0;j--){let b=bolts[j];if(Math.hypot(m.x-b.x,m.y-b.y)<m.r+5){meteors.splice(i,1);bolts.splice(j,1);spaceScore+=10;$('spaceScore').textContent='Pontos: '+spaceScore;hit=true;break}}
 if(!hit&&m.y>ship.y-12&&Math.abs(m.x-ship.x)<m.r+10){meteors.splice(i,1);spaceLives--;$('spaceLives').textContent='Escudos: '+spaceLives;if(spaceLives<=0){endShooter();return}}
 else if(!hit&&m.y>315)meteors.splice(i,1)}
 drawSpace();requestAnimationFrame(frame)}
$('startShooter').onclick=()=>{resetShooter();spaceRunning=true;$('spaceHelp').textContent='Desvie dos meteoros e marque pontos!';requestAnimationFrame(frame)};
$('moveLeft').onpointerdown=()=>keys.left=true;$('moveLeft').onpointerup=()=>keys.left=false;$('moveLeft').onpointerleave=()=>keys.left=false;
$('moveRight').onpointerdown=()=>keys.right=true;$('moveRight').onpointerup=()=>keys.right=false;$('moveRight').onpointerleave=()=>keys.right=false;
$('fireSpace').onpointerdown=()=>keys.fire=true;$('fireSpace').onpointerup=()=>keys.fire=false;$('fireSpace').onpointerleave=()=>keys.fire=false;
window.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();if(e.key===' ')keys.Space=true;else keys[e.key]=true});
window.addEventListener('keyup',e=>{if(e.key===' ')keys.Space=false;else keys[e.key]=false});
drawSpace();
// AI chat
let history=[];
async function checkAI(){try{const r=await fetch('/api/health');const d=await r.json();$('aiStatus').textContent=d.aiConfigured?'IA conectada':'Servidor sem chave de IA';}catch{$('aiStatus').textContent='Modo local • publique o servidor';}}
checkAI();
$('send').onclick=async()=>{const msg=$('question').value.trim();if(!msg)return;const log=$('chatlog');const add=(txt,cls)=>{const d=document.createElement('div');d.className='msg '+cls;d.textContent=txt;log.appendChild(d);log.scrollTop=log.scrollHeight};add(msg,'user');$('question').value='';$('send').disabled=true;$('chatStatus').textContent='Pensando…';try{const r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:msg,history})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Não foi possível conectar.');add(d.reply,'bot');history.push({role:'user',content:msg},{role:'assistant',content:d.reply});history=history.slice(-10);$('chatStatus').textContent='Resposta recebida.'}catch(e){add(e.message+' Se estiver abrindo o HTML diretamente, inicie o servidor conforme o LEIA-ME.','bot');$('chatStatus').textContent='Verifique a configuração do servidor.'}finally{$('send').disabled=false}};
$('question').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('send').click()}});
</script></body></html>
